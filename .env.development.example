# Copy to .env.development and fill in values.
# Loaded with: dotenvx run -f .env .env.development (e.g. bun env:dev ...)

# -----------------------------------------------------------------------------
# Required for auth and app server
# -----------------------------------------------------------------------------

# App + auth base URL (use your dev server; Metro often serves on 8081)
ONE_SERVER_URL=http://localhost:8081
BETTER_AUTH_URL=http://localhost:8081

# Auth signing secret (min 32 chars). Generate: npx @better-auth/cli secret  or  openssl rand -base64 32
BETTER_AUTH_SECRET=your-dev-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Required only if running Zero sync server or DB migrations
# -----------------------------------------------------------------------------

# Zero server URL (client-side; often same host as app in dev)
VITE_PUBLIC_ZERO_SERVER=http://localhost:4948

# Postgres for Zero (only needed for backend/migrations). Use Docker or local Postgres.
# ZERO_UPSTREAM_DB=postgresql://user:password@127.0.0.1:5432/postgres
# ZERO_CVR_DB=postgresql://user:password@127.0.0.1:5432/zero_cvr
# ZERO_CHANGE_DB=postgresql://user:password@127.0.0.1:5432/zero_cdb
