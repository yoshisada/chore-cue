# QA Test Credentials
# Copy this file to .kiln/qa/config/.env.test and fill in values.
# .env.test is gitignored — NEVER commit real credentials.

# Test user for login/session/chore CRUD flows
QA_TEST_USER_EMAIL=
QA_TEST_USER_PASSWORD=

# Second household member (for bump flows — must be a different user)
QA_TEST_MEMBER_EMAIL=
QA_TEST_MEMBER_PASSWORD=

# Dev server URL (default: http://localhost:8081)
DEV_URL=http://localhost:8081
